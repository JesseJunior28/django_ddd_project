FROM python:3.12-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DJANGO_DEBUG=False
WORKDIR /app
COPY requirements.txt requirements-production.txt requirements-production.lock ./
RUN pip install --no-cache-dir -r requirements-production.txt \
    && pip check \
    && useradd --uid 1000 --create-home app
COPY . .
USER app
EXPOSE 8000
CMD ["gunicorn", "--config", "config/gunicorn.py", "config.wsgi:application"]
